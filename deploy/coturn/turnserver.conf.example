# Copy to turnserver.conf and replace the placeholders.
#
# This listener configuration supports direct UDP, TCP fallback, and
# TLS-over-TCP fallback for browsers on restrictive networks.

listening-port=3478
tls-listening-port=5349

fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
realm=turn.example.com

cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# The coturn image runs as nobody (65534:65533): the certificate files must be
# readable by that user, or coturn starts without its TLS listener.

# Use this when coturn is behind a NAT. Otherwise omit it.
# external-ip=PUBLIC_IP/PRIVATE_IP

# The only peer a SlowMeet browser needs to reach through the relay is the
# SlowMeet server. Deny everything else so a TURN credential cannot be used to
# relay to arbitrary hosts or to reach private services behind the firewall.
# coturn checks allowed-peer-ip before denied-peer-ip. Allow the address the
# server advertises (ICE_PUBLIC_IP), plus its private address behind a NAT.
no-multicast-peers
no-tcp-relay
denied-peer-ip=0.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
allowed-peer-ip=SLOWMEET_SERVER_PUBLIC_IP

# Keep this range separate from SlowMeet's ICE_UDP_PORT_MIN/MAX range; the
# compose example publishes 50000-50100/udp, so the relay range must stop
# below it to avoid bind races with the Docker userland proxy.
min-port=49152
max-port=49999
