[Unit]
Description=SlowMeet self-hosted meeting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=slowmeet
Group=slowmeet
WorkingDirectory=/opt/slowmeet
EnvironmentFile=/opt/slowmeet/.env
ExecStart=/opt/slowmeet/slowmeet
Restart=on-failure
RestartSec=5s
LimitNOFILE=16384
# Go does not automatically apply systemd's cgroup memory limit as GOMEMLIMIT.
# Match the Compose soft heap default; /opt/slowmeet/.env can override it.
Environment=GOMEMLIMIT=200MiB
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/slowmeet/data

[Install]
WantedBy=multi-user.target
