[Unit]
Description=LowMeet self-hosted meeting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lowmeet
Group=lowmeet
WorkingDirectory=/opt/lowmeet
EnvironmentFile=/opt/lowmeet/.env
ExecStart=/opt/lowmeet/lowmeet
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lowmeet/data

[Install]
WantedBy=multi-user.target
