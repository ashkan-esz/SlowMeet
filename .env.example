APP_ENV=production
APP_NAME=SlowMeet
HTTP_ADDR=:8080
HTTP_PUBLISH_ADDRESS=127.0.0.1
# Trust X-Forwarded-For only from these immediate proxy CIDRs; blank disables it.
TRUSTED_PROXY_CIDRS=
# Host-side loopback port forwarded to the app's container port 8080.
HTTP_PUBLISH_PORT=8080

# Optional Compose override files, colon-separated and relative to this
# directory. Docker Compose reads this from .env whenever it is run here without
# -f, and the installer and its updates honour it too, so a deployment keeps its
# overrides automatically. Example: run SlowMeet on the host network (no
# docker-proxy process per media port, no NAT); see deploy/compose.host-network.yml.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.host-network.yml
CONFIG_FILE=data/config.json

MEETING_PASSWORD=
ADMIN_PASSWORD=

STUN_SERVERS=
TURN_URL=
# Comma-separated URLs, for example:
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# When TURN_SHARED_SECRET is set, per-participant REST credentials are generated
# from it automatically (TURN_USERNAME/TURN_PASSWORD are then ignored).
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
# Long random secret that signs the TURN credentials handed to participants;
# generate with `openssl rand -hex 32`. The built-in TURN relay verifies them
# with it and requires it. An external TURN server must be given the same
# secret (coturn: use-auth-secret with static-auth-secret).
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400
# Seconds between ICE restarts for the rotating TURN methods ("TURN over TCP
# (rotating)", "TURN over TLS (rotating)"); 0 disables those methods, otherwise
# 10-600. Some networks degrade a real-time TCP flow ~20 s after it starts;
# rotation moves media to fresh TURN connections before that. "Automatic"
# prefers the rotating methods when direct UDP fails.
TURN_TCP_ROTATE_SECONDS=12

# Built-in TURN relay. SlowMeet can relay TURN itself, so no separate TURN
# server is needed. To use it, set TURN_SHARED_SECRET, name this host in
# TURN_URLS, and switch it on: with Docker or Podman Compose add
# deploy/compose.turn.yml or deploy/podman-compose.turn.yml (they also publish
# the listen ports and mount the certificate); elsewhere set
# TURN_SERVER_ENABLED=true. The relay forwards only to this server's own media
# addresses. Leave it off to use an external TURN server through TURN_URLS.
TURN_SERVER_ENABLED=false
# Listen ports: TURN over UDP and TCP, and TURN over TLS. TURN_URLS must name
# the same ports. TURN_SERVER_TLS_PORT=0 turns the TLS listener off (not with
# the Compose overrides, which publish that port).
TURN_SERVER_PORT=3478
TURN_SERVER_TLS_PORT=5349
# Certificate and key for TURN over TLS, as paths the process can read. Renewed
# files are picked up without a restart; while they are missing, TURN over UDP
# and TCP still work. The Compose overrides set both to the files mounted from
# TURN_CERT_DIR, so leave them empty there.
TURN_SERVER_TLS_CERT_FILE=
TURN_SERVER_TLS_KEY_FILE=
TURN_SERVER_REALM=slowmeet
# UDP ports for relay allocations. Only this server's own SFU sends to them, so
# they need neither publishing nor a firewall rule; they must not overlap
# ICE_UDP_PORT_MIN-ICE_UDP_PORT_MAX. A relayed participant holds one, and
# several at once while a rotating method is in use.
TURN_SERVER_RELAY_PORT_MIN=49152
TURN_SERVER_RELAY_PORT_MAX=49999
# Local IPv4 address the relay sockets bind. Empty selects it automatically:
# ICE_PUBLIC_IP when this host owns that address, otherwise the address of the
# default route.
TURN_SERVER_RELAY_IP=
# One local address for the relay's listeners (TURN_SERVER_PORT and
# TURN_SERVER_TLS_PORT). Empty listens on every address of the host. For
# host-network and non-container installs with a second address; in a bridge
# network use TURN_TLS_PUBLISH instead (see deploy/compose.turn.yml).
TURN_SERVER_LISTEN_IP=

# Prefer IPv4 for deployments where IPv6 reachability is inconsistent.
ICE_IPV4_ONLY=true

# all allows direct ICE and configured TURN candidates; relay forces TURN.
# relay (with a TURN relay configured) routes every ICE pair through TURN:
# use it when the path between clients and the server kills sustained UDP
# flows (consent failures every ~10s, media stalls) while TCP survives —
# see docs/vps-regression-diagnostics.md for the diagnosis and trade-offs.
# Requires TURN_URLS (TCP transport survives the most restrictive paths) and
# TURN_SHARED_SECRET. Revert to all when direct UDP is confirmed healthy.
ICE_TRANSPORT_POLICY=all
# Enable camera simulcast only after staging validation across supported browsers.
SIMULCAST_ENABLED=false
# Ask browsers for discontinuous Opus: silent and muted participants send a
# comfort-noise packet every 400 ms instead of 50 packets per second. Cuts
# server CPU and every listener's downlink. Set false only to rule it out
# while debugging an audio problem.
OPUS_DTX_ENABLED=true
# Video codecs participants may send (any of av1, vp9, vp8, h264; vp8 must be
# listed), and the one browsers use unless the participant picks another. A
# room only uses a codec every participant's device supports, so a device
# without the default makes everyone fall back to an older codec while it is
# there. Both can be changed on the admin page without a restart.
VIDEO_CODECS=av1,vp9,vp8,h264
DEFAULT_VIDEO_CODEC=av1

# Publish this UDP range from the host for direct ICE connectivity.
ICE_UDP_PORT_MIN=50000
ICE_UDP_PORT_MAX=50100
# Optional public address to advertise when the server is behind 1:1 NAT.
ICE_PUBLIC_IP=

MAX_PARTICIPANTS=5
DEFAULT_VIDEO_QUALITY=low
MAX_VIDEO_QUALITY=ultra
DEFAULT_VIDEO_FPS=15
MAX_VIDEO_FPS=60
DEFAULT_AUDIO_BITRATE=32000
MAX_VIDEO_BITRATE=3000000
MAX_AUDIO_BITRATE=96000
ENABLE_SCREEN_SHARE=true
# Seconds a disconnected participant keeps their slot for reconnecting.
# 0 disables the grace period: the slot is released immediately.
RECONNECT_TIMEOUT_SECONDS=30
LOG_LEVEL=info

# Container resource limits. Increase these for larger meetings. The built-in
# TURN relay runs inside the same container and shares them. With TURN enabled
# the installer raises the memory limit to 384m and the heap limit to 300MiB
# when they are still the values shipped here; it leaves the CPU limit alone.
SLOWMEET_CPUS=0.75
SLOWMEET_MEMORY_LIMIT=256m
SLOWMEET_PIDS_LIMIT=128
# Compose-only soft Go heap limit. Keep it ~80% of SLOWMEET_MEMORY_LIMIT so
# collection starts before the cgroup OOM killer acts. Bare-metal systemd
# uses the unit's GOMEMLIMIT=200MiB default; override it in /opt/slowmeet/.env
# with a bare GOMEMLIMIT= line. Set GOMAXPROCS to the whole CPU allowance
# (e.g. 1 for the 0.75-CPU default) if you tune it.
SLOWMEET_GOMEMLIMIT=200MiB

# Directory holding fullchain.pem and privkey.pem for the built-in TURN relay's
# TLS listener; deploy/compose.turn.yml mounts it read-only. The files must be
# readable by the container user (10001). Keep real certificates local.
TURN_CERT_DIR=./deploy/turn-certs
