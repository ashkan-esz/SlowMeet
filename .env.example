APP_ENV=production
APP_NAME=SlowMeet
HTTP_ADDR=:8080
HTTP_PUBLISH_ADDRESS=127.0.0.1
# Trust X-Forwarded-For only from these immediate proxy CIDRs; blank disables it.
TRUSTED_PROXY_CIDRS=
# Host-side loopback port forwarded to the app's container port 8080.
HTTP_PUBLISH_PORT=8080

# Optional Compose override files, colon-separated and relative to this
# directory. Docker Compose reads this from .env whenever it is run here without
# -f, and the installer and its updates honour it too, so a deployment keeps its
# overrides automatically. Example: run SlowMeet on the host network (no
# docker-proxy process per media port, no NAT); see deploy/compose.host-network.yml.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.host-network.yml
CONFIG_FILE=data/config.json

MEETING_PASSWORD=
ADMIN_PASSWORD=

STUN_SERVERS=
TURN_URL=
# Comma-separated URLs, for example:
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# When TURN_SHARED_SECRET is set, per-participant REST credentials are generated
# from it automatically (TURN_USERNAME/TURN_PASSWORD are then ignored).
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
# Long random secret shared with coturn's static-auth-secret; generate with
# `openssl rand -hex 32`. Required for TURN when the coturn profile is enabled.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400
# Seconds between ICE restarts for the rotating TURN methods ("TURN over TCP
# (rotating)", "TURN over TLS (rotating)"); 0 disables those methods, otherwise
# 10-600. Some networks degrade a real-time TCP flow ~20 s after it starts;
# rotation moves media to fresh TURN connections before that. "Automatic"
# prefers the rotating methods when direct UDP fails.
TURN_TCP_ROTATE_SECONDS=12

# Prefer IPv4 for deployments where IPv6 reachability is inconsistent.
ICE_IPV4_ONLY=true

# all allows direct ICE and configured TURN candidates; relay forces TURN.
# relay (with the coturn profile enabled) routes every ICE pair through TURN:
# use it when the path between clients and the server kills sustained UDP
# flows (consent failures every ~10s, media stalls) while TCP survives —
# see docs/vps-regression-diagnostics.md for the diagnosis and trade-offs.
# Requires TURN_URLS (TCP transport survives the most restrictive paths) and
# TURN_SHARED_SECRET. Revert to all when direct UDP is confirmed healthy.
ICE_TRANSPORT_POLICY=all
# Enable camera simulcast only after staging validation across supported browsers.
SIMULCAST_ENABLED=false
# Ask browsers for discontinuous Opus: silent and muted participants send a
# comfort-noise packet every 400 ms instead of 50 packets per second. Cuts
# server CPU and every listener's downlink. Set false only to rule it out
# while debugging an audio problem.
OPUS_DTX_ENABLED=true

# Publish this UDP range from the host for direct ICE connectivity.
ICE_UDP_PORT_MIN=50000
ICE_UDP_PORT_MAX=50100
# Optional public address to advertise when the server is behind 1:1 NAT.
ICE_PUBLIC_IP=

MAX_PARTICIPANTS=5
DEFAULT_VIDEO_QUALITY=low
MAX_VIDEO_QUALITY=ultra
DEFAULT_VIDEO_FPS=15
MAX_VIDEO_FPS=60
DEFAULT_AUDIO_BITRATE=32000
MAX_VIDEO_BITRATE=3000000
MAX_AUDIO_BITRATE=96000
ENABLE_SCREEN_SHARE=true
# Seconds a disconnected participant keeps their slot for reconnecting.
# 0 disables the grace period: the slot is released immediately.
RECONNECT_TIMEOUT_SECONDS=30
LOG_LEVEL=info

# Container resource limits. Increase these for larger meetings.
SLOWMEET_CPUS=0.75
SLOWMEET_MEMORY_LIMIT=256m
SLOWMEET_PIDS_LIMIT=128
# Compose-only soft Go heap limit. Keep it ~80% of SLOWMEET_MEMORY_LIMIT so
# collection starts before the cgroup OOM killer acts. Bare-metal systemd
# uses the unit's GOMEMLIMIT=200MiB default; override it in /opt/slowmeet/.env
# with a bare GOMEMLIMIT= line. Set GOMAXPROCS to the whole CPU allowance
# (e.g. 1 for the 0.75-CPU default) if you tune it.
SLOWMEET_GOMEMLIMIT=200MiB

# Optional coturn profile paths. Keep the real config and certificates local.
TURN_CONFIG_FILE=./deploy/coturn/turnserver.conf
TURN_CERT_DIR=./deploy/coturn/certs
TURN_CPUS=0.20
TURN_MEMORY_LIMIT=128m
TURN_PIDS_LIMIT=128
