APP_ENV=production
APP_NAME=SlowMeet
HTTP_ADDR=:8080
HTTP_PUBLISH_ADDRESS=127.0.0.1
# Trust X-Forwarded-For only from these immediate proxy CIDRs; blank disables it.
TRUSTED_PROXY_CIDRS=
# Host-side loopback port forwarded to the app's container port 8080.
HTTP_PUBLISH_PORT=8080
CONFIG_FILE=data/config.json

MEETING_PASSWORD=
ADMIN_PASSWORD=

STUN_SERVERS=
TURN_URL=
# Comma-separated URLs, for example:
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400

# Prefer IPv4 for deployments where IPv6 reachability is inconsistent.
ICE_IPV4_ONLY=true

# all allows direct ICE and configured TURN candidates; relay forces TURN.
ICE_TRANSPORT_POLICY=all
# Enable camera simulcast only after staging validation across supported browsers.
SIMULCAST_ENABLED=false

# Publish this UDP range from the host for direct ICE connectivity.
ICE_UDP_PORT_MIN=50000
ICE_UDP_PORT_MAX=50100
# Optional public address to advertise when the server is behind 1:1 NAT.
ICE_PUBLIC_IP=

MAX_PARTICIPANTS=5
DEFAULT_VIDEO_QUALITY=low
MAX_VIDEO_QUALITY=ultra
DEFAULT_VIDEO_FPS=15
MAX_VIDEO_FPS=60
DEFAULT_AUDIO_BITRATE=32000
MAX_VIDEO_BITRATE=3000000
MAX_AUDIO_BITRATE=96000
ENABLE_SCREEN_SHARE=true
# Seconds a disconnected participant keeps their slot for reconnecting.
# 0 disables the grace period: the slot is released immediately.
RECONNECT_TIMEOUT_SECONDS=30
LOG_LEVEL=info

# Container resource limits. Increase these for larger meetings.
SLOWMEET_CPUS=0.75
SLOWMEET_MEMORY_LIMIT=256m
SLOWMEET_PIDS_LIMIT=128
# Compose-only soft Go heap limit. Keep it ~80% of SLOWMEET_MEMORY_LIMIT so
# collection starts before the cgroup OOM killer acts. Bare-metal systemd
# uses the unit's GOMEMLIMIT=200MiB default; override it in /opt/slowmeet/.env
# with a bare GOMEMLIMIT= line. Set GOMAXPROCS to the whole CPU allowance
# (e.g. 1 for the 0.75-CPU default) if you tune it.
SLOWMEET_GOMEMLIMIT=200MiB

# Optional coturn profile paths. Keep the real config and certificates local.
TURN_CONFIG_FILE=./deploy/coturn/turnserver.conf
TURN_CERT_DIR=./deploy/coturn/certs
TURN_CPUS=0.20
TURN_MEMORY_LIMIT=128m
TURN_PIDS_LIMIT=128
